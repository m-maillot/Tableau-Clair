# Copier vers `.env` (jamais commité). Les valeurs ci-dessous conviennent au dev local ;
# en production, remplacer chaque valeur marquée « PROD ».
# Les variables marquées (ticket N) ne sont lues par le code que lorsque ce ticket est livré.

# --- Application -------------------------------------------------------------
# Domaine public servi par Caddy, sans schéma. PROD : tableau-clair.fr
DOMAIN=localhost
# URL publique de l'application (liens magiques, redirections OAuth). PROD : https://tableau-clair.fr
APP_URL=http://localhost:5173

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=tableau
# PROD : mot de passe fort
POSTGRES_PASSWORD=tableau
POSTGRES_DB=tableau_clair
POSTGRES_PORT=5432
# Dev (API lancée sur la machine). En prod, la valeur est construite par docker-compose.prod.yml.
DATABASE_URL=postgres://tableau:tableau@localhost:5432/tableau_clair

# --- Stockage objet S3 (ticket 07) ----------------------------------------------
# Dev : MinIO du docker-compose.yml. PROD : S3 externe, bucket privé.
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=tableau-clair
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PORT=9010
S3_CONSOLE_PORT=9011

# --- E-mails (ticket 05) --------------------------------------------------------
# Dev : Mailpit (interface sur http://localhost:8025). PROD : SMTP Brevo.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Tableau Clair <no-reply@tableau-clair.fr>
MAILPIT_UI_PORT=8025

# --- Authentification (ticket 05) -----------------------------------------------
# Secret de signature des sessions : `openssl rand -base64 32`. PROD : valeur unique.
AUTH_SECRET=change-me
# Adresses autorisées à se connecter, séparées par des virgules (inscriptions fermées).
ALLOWED_EMAILS=martial@racomach.fr
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
